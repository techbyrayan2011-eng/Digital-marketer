<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marketing Bestie 💬✨</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        chat: {
                            bg: '#0f172a',
                            card: '#1e293b',
                            bubbleUser: '#6366f1',
                            bubbleFriend: '#334155'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-chat-bg text-slate-100 font-sans h-screen flex flex-col justify-between overflow-hidden">

    <!-- HEADER -->
    <header class="bg-slate-900 border-b border-slate-800 px-4 py-3 shrink-0">
        <div class="max-w-2xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center text-xl shadow-lg">
                        👾
                    </div>
                    <span class="w-3 h-3 bg-emerald-500 border-2 border-slate-900 rounded-full absolute bottom-0 right-0"></span>
                </div>
                <div>
                    <h1 class="font-bold text-base flex items-center gap-2">
                        Alex <span class="text-xs font-normal text-indigo-400 bg-indigo-950 px-2 py-0.5 rounded-full border border-indigo-800">Marketing Bestie</span>
                    </h1>
                    <p class="text-xs text-slate-400">Online • Ready to chill & learn</p>
                </div>
            </div>

            <!-- Stats Pill -->
            <div class="flex items-center gap-3 bg-slate-800 px-3 py-1.5 rounded-2xl border border-slate-700 text-xs font-semibold">
                <span id="streak-display"><i class="fa-solid fa-fire text-amber-500"></i> Day 1</span>
                <span class="text-slate-600">|</span>
                <span id="xp-display" class="text-indigo-400">0 XP</span>
            </div>
        </div>
    </header>

    <!-- CHAT MESSAGES AREA -->
    <main id="chat-box" class="flex-grow max-w-2xl w-full mx-auto p-4 overflow-y-auto space-y-4 custom-scrollbar">
        <!-- Messages rendered dynamically -->
    </main>

    <!-- QUICK TOPIC SUGGESTIONS -->
    <div id="quick-topics" class="max-w-2xl w-full mx-auto px-4 py-2 flex gap-2 overflow-x-auto custom-scrollbar shrink-0">
        <button onclick="sendQuickTopic('How do I start a viral TikTok account?')" class="bg-slate-800 hover:bg-slate-700 text-xs text-indigo-300 border border-indigo-500/30 px-3 py-1.5 rounded-full whitespace-nowrap transition">
            🚀 Viral TikTok Strategy
        </button>
        <button onclick="sendQuickTopic('Explain Target Audience like I am 5')" class="bg-slate-800 hover:bg-slate-700 text-xs text-pink-300 border border-pink-500/30 px-3 py-1.5 rounded-full whitespace-nowrap transition">
            🎯 Target Audience
        </button>
        <button onclick="sendQuickTopic('Give me a fun mini marketing challenge!')" class="bg-slate-800 hover:bg-slate-700 text-xs text-amber-300 border border-amber-500/30 px-3 py-1.5 rounded-full whitespace-nowrap transition">
            🎮 Quick Challenge
        </button>
    </div>

    <!-- INPUT BAR -->
    <footer class="bg-slate-900 border-t border-slate-800 p-3 shrink-0">
        <div class="max-w-2xl mx-auto flex items-center gap-2">
            <input 
                type="text" 
                id="user-input" 
                placeholder="Talk to Alex about marketing, ideas, or challenges..." 
                class="flex-grow bg-slate-800 border border-slate-700 rounded-2xl px-4 py-3 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-indigo-500 transition"
                onkeypress="handleKeyPress(event)"
            />
            <button 
                onclick="sendMessage()" 
                class="bg-indigo-600 hover:bg-indigo-500 text-white w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 transition shadow-lg"
            >
                <i class="fa-solid fa-paper-plane text-sm"></i>
            </button>
        </div>
    </footer>

    <script>
        const apiKey = "";
        let playerXP = 0;

        // INITIAL CONVERSATION HISTORY
        let chatHistory = [
            {
                role: "assistant",
                text: "Hey Rayan! ✋ What's up? I'm Alex, your marketing bestie!\n\nForget boring textbooks or lectures. Think of me like a friend who loves breaking down how big brands, YouTubers, and sneaker stores trick us into loving their stuff. 👟 Head over to the quick topics below or ask me whatever is on your mind!"
            }
        ];

        window.onload = function() {
            renderChat();
        };

        function renderChat() {
            const chatBox = document.getElementById("chat-box");
            chatBox.innerHTML = "";

            chatHistory.forEach((msg, idx) => {
                const isUser = msg.role === "user";
                const wrapper = document.createElement("div");
                wrapper.className = `flex ${isUser ? "justify-end" : "justify-start"} items-end gap-2`;

                if (!isUser) {
                    const avatar = document.createElement("div");
                    avatar.className = "w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center text-xs shrink-0 mb-1";
                    avatar.innerText = "👾";
                    wrapper.appendChild(avatar);
                }

                const bubble = document.createElement("div");
                bubble.className = `max-w-[85%] md:max-w-[75%] rounded-2xl px-4 py-3 text-sm leading-relaxed ${
                    isUser 
                        ? "bg-indigo-600 text-white rounded-br-none" 
                        : "bg-slate-800 text-slate-200 border border-slate-700/80 rounded-bl-none"
                }`;

                // Format newlines as paragraphs
                const formattedText = msg.text.replace(/\n/g, '<br>');
                bubble.innerHTML = formattedText;

                wrapper.appendChild(bubble);
                chatBox.appendChild(wrapper);
            });

            // Scroll to bottom
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function handleKeyPress(e) {
            if (e.key === "Enter") {
                sendMessage();
            }
        }

        function sendQuickTopic(text) {
            document.getElementById("user-input").value = text;
            sendMessage();
        }

        async function sendMessage() {
            const inputField = document.getElementById("user-input");
            const text = inputField.value.trim();
            if (!text) return;

            // Append user msg
            chatHistory.push({ role: "user", text: text });
            inputField.value = "";
            renderChat();

            // Give user +5 XP for chatting/interacting
            playerXP += 5;
            document.getElementById("xp-display").innerText = `${playerXP} XP`;

            // Append typing indicator
            const chatBox = document.getElementById("chat-box");
            const typingWrapper = document.createElement("div");
            typingWrapper.id = "typing-indicator";
            typingWrapper.className = "flex justify-start items-center gap-2";
            typingWrapper.innerHTML = `
                <div class="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center text-xs shrink-0">👾</div>
                <div class="bg-slate-800 border border-slate-700 rounded-2xl px-4 py-2 text-xs text-slate-400 italic animate-pulse">
                    Alex is typing...
                </div>
            `;
            chatBox.appendChild(typingWrapper);
            chatBox.scrollTop = chatBox.scrollHeight;

            // System prompt for Gemini
            const systemPrompt = `You are Alex, a super cool, friendly high school senior/marketing bestie talking to Rayan, a 9th standard beginner.
Rules:
1. Speak like a close friend talking over chat/WhatsApp. Use emojis, simple slang (chill, lowkey, vibe, no cap), and real-world teenager examples (sneakers, burgers, gaming, Instagram/TikTok, YouTube).
2. NEVER lecture or sound like a teacher.
3. Keep answers conversational, short, and broken into easy readable paragraphs.
4. If appropriate, toss in a mini choice or decision question at the end to keep Rayan engaged!`;

            // Prepare API payload history
            const apiContents = chatHistory.map(m => ({
                role: m.role === "assistant" ? "model" : "user",
                parts: [{ text: m.text }]
            }));

            let backoff = 1000;
            let responseText = "";

            for (let attempt = 0; attempt < 5; attempt++) {
                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            contents: apiContents,
                            systemInstruction: { parts: [{ text: systemPrompt }] }
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        responseText = data.candidates?.[0]?.content?.parts?.[0]?.text || "Haha honestly, that's a cool idea! What do you think we should test next?";
                        break;
                    }
                } catch (e) {
                    // Retry logic
                }
                await new Promise(r => setTimeout(r, backoff));
                backoff *= 2;
            }

            if (!responseText) {
                responseText = "Sorry bro, my wifi glitched for a second! But basically, marketing is just getting the right product in front of the right person at the right time. What business idea do you want to brainstorm?";
            }

            // Remove typing indicator & render
            const typingElem = document.getElementById("typing-indicator");
            if (typingElem) typingElem.remove();

            chatHistory.push({ role: "assistant", text: responseText });
            renderChat();
        }
    </script>
</body>
</html>


